(seq
    (fromimport test.utils (+ pp check ==))
    (bindfn
        (fn (args x)
            (seq
                (apply (getfn + 2) (getval x) (lit 1))
            )
        )
        addOne
    )
    (apply
        (getfn check 3)
        (apply
            (getfn pp 1)
            (apply (getfn addOne 1) (lit 5))
        )
        (getfn == 2)
        (lit 6)
    )
)
